# SimTest Environment Variables

# 1. LLM Configuration
# Required: Google Gemini API Key for fallback planning and initial world model building.
GEMINI_API_KEY="your-api-key-here"

# 2. Neural Microservice Configuration
# Set to 'true' to enable the PyTorch GraphSAGE World Model.
USE_NEURAL_WM="true"

# The URL of the Python FastAPI service.
NEURAL_WM_URL="http://127.0.0.1:8000/predict"

# 3. Debugging
# Set to 'true' to enable full stack traces on application crashes.
# DEBUG="true"
